# FotoCaloria - variaveis de ambiente
# Copie este arquivo para ".env.local" e preencha com seus valores.
# NUNCA commite chaves reais. Todas as chaves ficam APENAS no servidor.

# ---------------------------------------------------------------------------
# Provedor de IA (analise de imagens). Valores aceitos: "gemini" | "openai" | "demo"
# - "gemini" (padrao recomendado): usa GOOGLE/GEMINI_API_KEY
# - "openai": usa OPENAI_API_KEY
# - "demo": dados ficticios claramente identificados, sem chamada de rede
#
# Se AI_PROVIDER nao for definido e nenhuma chave existir, o app roda em "demo".
AI_PROVIDER=gemini

# Modelo multimodal. Exemplos: gemini-3.5-flash, gemini-3.8-flash, gemini-2.5-flash, gpt-4o-mini
AI_MODEL=

# Chave de API do Gemini (Google AI Studio). SOMENTE no servidor.
GEMINI_API_KEY=
# Alternativa aceita como fallback:
GOOGLE_API_KEY=

# Chave de API da OpenAI (opcional, apenas se AI_PROVIDER=openai).
OPENAI_API_KEY=
# Base URL opcional para provedores compativeis com OpenAI.
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Protecao / limites (opcional)
# Numero maximo de analises por IP dentro da janela (padrao: 10).
ANALYZE_RATE_LIMIT=
# Janela do limite em segundos (padrao: 60).
ANALYZE_RATE_WINDOW_SECONDS=
